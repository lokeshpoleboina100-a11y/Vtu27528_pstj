import java.util.*;

public class Solution {

    public static void main(String[] args) {

        Scanner sc = new Scanner(System.in);

        int n = sc.nextInt();
        int p = sc.nextInt();

        try {
            System.out.println(n / p);
        }
        catch (ArithmeticException e) {
            System.out.println(e);
        }

        sc.close();
    }
}
