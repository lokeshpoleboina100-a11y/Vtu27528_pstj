class Solution(object):
    def halvesAreAlike(self, s):
        n=len(s)
        a=n//2
        b=a
        counta=0
        vowels="aeiouAEIOU"
        for char in s[:a]:
            if char in vowels:
                counta=counta+1
        countb=0
        for char in s[b:]:
            if char in vowels:
                countb=countb+1
        if counta==countb:
            return True
        return False
        
            
